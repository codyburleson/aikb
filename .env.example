# Google AI API Configuration
# Get your API key from: https://ai.google.dev/

# Your Google AI API Key
# https://aistudio.google.com/api-keys
GOOGLE_API_KEY=your_api_key_here

# Vault Configuration
# Path to the reference vault directory (supports relative, absolute, and ~ for home directory)
# Examples: ./reference-vault, /Users/username/my-vault, ~/Documents/my-vault
VAULT_ROOT=./reference-vault

# Optional: Project Configuration
# GOOGLE_CLOUD_PROJECT=your_project_id

# Debug Configuration
# Set to 'true' to enable detailed logging from the Google ADK LoggingPlugin
# Set to 'false' to disable verbose logging (recommended for production)
DEBUG=false

# --- TIMEZONE CONFIGURATION (Global Ready Fix) ---
# Sets the clock for created notes. 
# Common values: Asia/Kolkata, America/New_York, Asia/Tokyo, Europe/London
# If left empty, it defaults to the system/server time.
TIMEZONE=Asia/Kolkata