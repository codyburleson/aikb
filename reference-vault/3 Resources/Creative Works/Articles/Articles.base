views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder == "3 Resources/Creative Works/Articles"
        - file.ext != "base"
    order:
      - file.name
      - datePublished
      - tags
    columnSize:
      file.name: 308
      note.datePublished: 146
      note.name: 443
    cardSize: 280
